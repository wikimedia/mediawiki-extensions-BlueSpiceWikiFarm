<head>
    {{#refresh_interval}}<meta http-equiv="refresh" content="{{refresh_interval}}">{{/refresh_interval}}
    <title>{{{title}}}</title>
    <link rel="stylesheet" type="text/css" href="{{style}}">
</head>
<body>
    <div class="maintenance">
        <div class="content">
            <h1 class="heading">{{heading}}</h1>
            {{{content}}}
            {{#main_wiki_url}}
                <a class="main-wiki-link" href="{{main_wiki_url}}">{{main_wiki_label}}</a>
            {{/main_wiki_url}}
        </div>
    </div>
</body>
